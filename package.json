{
  "name": "@superinstance/flux-runtime-wasm",
  "version": "0.1.0",
  "description": "FLUX VM WebAssembly target — browser-based agent bytecode execution with ISA v3 support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "flux-wasm": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:esm": "tsc --module ES2020 --outDir dist-esm",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .ts",
    "compile": "node dist/cli.js compile",
    "run": "node dist/cli.js run",
    "example": "node dist/cli.js run examples/hello.flux",
    "benchmark": "node dist/benchmark.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "flux",
    "wasm",
    "webassembly",
    "bytecode",
    "vm",
    "agent",
    "runtime",
    "superinstance"
  ],
  "author": "SuperInstance (DiGennaro et al.)",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperInstance/flux-runtime-wasm.git"
  },
  "files": [
    "dist/",
    "src/"
  ]
}
